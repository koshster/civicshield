# Copy to .env and fill in. Never commit .env.
CIVICSHIELD_ENV=dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CIVICSHIELD_SECRET_KEY=dev-insecure-change-me
CIVICSHIELD_DATABASE_URL=postgresql+asyncpg://civicshield:civicshield@postgres:5432/civicshield
CIVICSHIELD_REDIS_URL=redis://redis:6379/0
CIVICSHIELD_LOG_LEVEL=INFO
CIVICSHIELD_LOG_JSON=true
# Set false only when serving over plain http://localhost in development.
CIVICSHIELD_COOKIE_SECURE=false

# Volunteer time per week that the "fix these this week" plan fills (minutes).
CIVICSHIELD_WEEKLY_BUDGET_MINUTES=120

# Scanner politeness
CIVICSHIELD_SCANNER_REQUESTS_PER_SECOND=2
CIVICSHIELD_SCANNER_BURST=5
CIVICSHIELD_SCANNER_TIMEOUT_SECONDS=10

# Optional: custom DNS servers (comma-separated). Leave empty to use the system resolver.
CIVICSHIELD_DNS_NAMESERVERS=
# Lab only: private CIDRs the scanner may reach. Rejected unless CIVICSHIELD_ENV=lab.
CIVICSHIELD_ALLOWED_PRIVATE_CIDRS=

# Optional LLM layer (phase 2). Leave empty to use template-only reports.
CIVICSHIELD_LLM_API_KEY=

# Postgres container credentials (used by docker-compose.yml)
POSTGRES_USER=civicshield
POSTGRES_PASSWORD=civicshield
POSTGRES_DB=civicshield
